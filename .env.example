# Curation runs through OpenRouter's chat-completions API with a bearer key.
# The model is pinned (no dynamic selection); override it here per run.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Digest emails are sent through Resend.
RESEND_API_KEY=
RECIPIENT_EMAIL=

# YouTube transcript fetches (youtube-transcript-api) are blocked from
# datacenter IPs (RequestBlocked). When set, ONLY transcript fetches route
# through this HTTP proxy — article fetches stay direct, so proxy bandwidth
# (the billed cost) stays minimal. DataImpulse rotating residential example:
#   http://<login>__cr.us:<password>@gw.dataimpulse.com:823
# Parameters go in the username after "__" (cr.us = US-only exit IPs); the
# host is gw.dataimpulse.com, port 823 for HTTP/HTTPS. Also set as the
# YT_TRANSCRIPT_PROXY_URL repo secret for the digest + smoke-test workflows.
YT_TRANSCRIPT_PROXY_URL=
